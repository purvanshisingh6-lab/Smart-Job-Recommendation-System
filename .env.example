# Local defaults use an embedded file-based H2 database.
PORT=8080
DB_URL=jdbc:h2:file:./data/smarthire;MODE=MySQL;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://YOUR-FRONTEND.vercel.app

# Optional MySQL production configuration (uncomment and set credentials):
# DB_URL=jdbc:mysql://HOST:3306/smarthire?useSSL=true&serverTimezone=UTC
# DB_USERNAME=YOUR_DB_USER
# DB_PASSWORD=YOUR_DB_PASSWORD
# DB_DRIVER=com.mysql.cj.jdbc.Driver
